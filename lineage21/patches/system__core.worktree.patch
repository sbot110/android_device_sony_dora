diff --git a/init/dora21_trace.h b/init/dora21_trace.h
new file mode 100644
index 000000000..405a9ae1e
--- /dev/null
+++ b/init/dora21_trace.h
@@ -0,0 +1,57 @@
+#pragma once
+// DORA21_ACTION_TRACE_V2
+#include <cerrno>
+#include <fcntl.h>
+#include <string>
+#include <sys/mount.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <android-base/logging.h>
+
+static inline void Dora21Trace(const char* label) {
+    LOG(INFO) << "DORA21 " << label;
+
+    struct stat root_st{}, cache_st{};
+    bool cache_mounted =
+        stat("/", &root_st) == 0 &&
+        stat("/cache", &cache_st) == 0 &&
+        root_st.st_dev != cache_st.st_dev;
+
+    const char* dir = cache_mounted
+        ? "/cache" : "/dev/dora21_trace";
+
+    bool mounted_here = false;
+
+    if (!cache_mounted) {
+        if (mkdir(dir, 0700) && errno != EEXIST) return;
+
+        if (mount("/dev/block/by-name/cache", dir, "ext4",
+                  MS_NOATIME | MS_NODEV | MS_NOSUID,
+                  nullptr) != 0) {
+            PLOG(ERROR) << "DORA21 cache mount failed";
+            return;
+        }
+        mounted_here = true;
+    }
+
+    const std::string filename =
+        std::string(dir) + "/dora-los21-firststage.log";
+
+    int fd = open(filename.c_str(),
+                  O_WRONLY | O_CREAT | O_APPEND |
+                  O_CLOEXEC | O_NOFOLLOW, 0644);
+
+    if (fd >= 0) {
+        const std::string line =
+            std::string("DORA21 ") + label + "\n";
+        (void)write(fd, line.data(), line.size());
+        (void)fsync(fd);
+        close(fd);
+    } else {
+        PLOG(ERROR) << "DORA21 log open failed";
+    }
+
+    if (mounted_here && umount(dir) != 0) {
+        PLOG(ERROR) << "DORA21 cache umount failed";
+    }
+}
