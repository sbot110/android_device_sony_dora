+// DORA21_CACHE_CHECKPOINT: temporary early boot diagnostics.
+static void DoraCacheCheckpoint(const char* label) {
+    LOG(INFO) << "DORA21 " << label;
+
+    // Android first-stage init runs before ueventd.
+    // Discover the cache partition independently.
+    if (access("/dev/block/by-name/cache", F_OK) != 0) {
+        static bool attempted = false;
+        if (!attempted) {
+            attempted = true;
+            BlockDevInitializer probe;
+            (void)probe.InitDevices({"cache"});
+        }
+    }
+
+    constexpr char kMountPoint[] = "/dev/dora_cache_trace";
+    constexpr char kDevice[] = "/dev/block/by-name/cache";
+
+    if (mkdir(kMountPoint, 0700) != 0 && errno != EEXIST) {
+        PLOG(ERROR) << "DORA21 cannot create cache mount point";
+        return;
+    }
+
+    if (mount(kDevice, kMountPoint, "ext4",
+              MS_NOATIME | MS_NODEV | MS_NOSUID, nullptr) != 0) {
+        PLOG(ERROR) << "DORA21 cannot mount cache";
+        return;
+    }
+
+    const std::string path =
+            std::string(kMountPoint) + "/dora-los21-firststage.log";
+
+    int fd = open(path.c_str(),
+                  O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC | O_NOFOLLOW,
+                  0644);
+
+    if (fd >= 0) {
+        const std::string line = std::string("DORA21 ") + label + "\n";
+        (void)write(fd, line.data(), line.size());
+        (void)fsync(fd);
+        close(fd);
+    } else {
+        PLOG(ERROR) << "DORA21 cannot open trace file";
+    }
+
+    if (umount(kMountPoint) != 0) {
+        PLOG(ERROR) << "DORA21 cannot unmount cache";
+    }
+}
